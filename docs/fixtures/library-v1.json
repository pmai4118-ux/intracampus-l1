      "successTransition": "matching verified RequestRejected => REJECTED / loan NONE / REFUNDED and copy released",
      "verification": "N-812 Foundry role/state/refund-recipient tests; N-5DF receipt/restart tests; N-696 staff reject queue flow"
    },
    "refund": {
      "producer": "STUDENT borrower signs claimExpiredRefund(requestId) for the original borrower address",
      "endpoint": "POST /api/library/requests/:requestId/transactions with action=refund and txHash; HTTP access is owner-scoped",
      "contractConsumer": "LibraryEscrow.claimExpiredRefund returns escrowed CAMPUS only to the original borrower and emits ExpiredRefundClaimed",
      "backendConsumer": "N-5DF validates borrower ownership, canonical receipt, chain/escrow, requestId, borrower and refund amount",
      "verifiedProof": "ExpiredRefundClaimed event matching requestId, original borrower and escrow address",
