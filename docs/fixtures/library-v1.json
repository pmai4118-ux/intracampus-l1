      "NONE": 0,
      "DEPOSITED": 1,
      "ACTIVE": 2,
      "REFUNDED": 3,
      "RETURN_SETTLED": 4,
      "LOST_SHORTFALL_DUE": 5,
      "LOST_SETTLED": 6
    }
  },
