      "RETURN_REQUESTED",
      "SETTLEMENT_PENDING",
      "RETURNED",
      "LOST_SHORTFALL_DUE",
      "LOST_SETTLED"
    ],
    "refund": [
      "NONE",
      "REFUND_DUE",
      "REFUNDED"
    ],
    "transaction": [
      "UNKNOWN",
      "SUBMITTED",
      "CONFIRMED",
      "REVERTED"
    ],
    "escrow": [
      "NONE",
      "DEPOSITED",
      "ACTIVE",
      "REFUNDED",
      "RETURN_SETTLED",
      "LOST_SHORTFALL_DUE",
      "LOST_SETTLED"
    ],
