HOST=127.0.0.1
PORT=4000
# Use the actual /ext/bc/<blockchain-id>/rpc URL from Avalanche CLI.
INTRACAMPUS_RPC_URL=
# B03: only needed for seed:demo --apply. Never commit a filled .env.
SEED_FUNDER_PRIVATE_KEY=
SEED_ISSUER_PRIVATE_KEY=
# Public values from L06, never the fixture verifier address on a real chain.
CAMPUS_PAYMENT_REGISTRY_ADDRESS=
CAMPUS_PAYMENT_DEPLOYMENT_BLOCK=
# Optional absolute path on a persistent local volume; default backend/data/invoices.sqlite.
INVOICES_DB_PATH=
# B01: server-only signing key and public recipient for parking-demo.
# Replace signer only together with a new L04 deployment (signer is immutable).
POS_SIGNER_PRIVATE_KEY=
PARKING_MERCHANT_ADDRESS=
