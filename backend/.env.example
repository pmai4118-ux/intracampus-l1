HOST=127.0.0.1
PORT=4000
# Use the actual /ext/bc/<blockchain-id>/rpc URL from Avalanche CLI.
INTRACAMPUS_RPC_URL=
# B01/B02 fail closed when the latest chain timestamp is too old or too far ahead of local time.
INVOICE_CHAIN_MAX_STALE_SECONDS=300
INVOICE_CHAIN_MAX_FUTURE_DRIFT_SECONDS=30
# B03: server-only keys, only needed for seed:demo --apply. Never commit a filled .env.
# These sign backend-initiated seed transactions; they are not student payment wallets.
SEED_FUNDER_PRIVATE_KEY=
SEED_ISSUER_PRIVATE_KEY=
# B05 grant issuer only. Needed exclusively for seed:grants --apply; must match L06 grantIssuer.
SEED_GRANT_ISSUER_PRIVATE_KEY=
# Public values from L06, never the fixture verifier address on a real chain.
CAMPUS_PAYMENT_REGISTRY_ADDRESS=
CAMPUS_PAYMENT_DEPLOYMENT_BLOCK=
# Optional absolute path on a persistent local volume; default backend/data/invoices.sqlite.
INVOICES_DB_PATH=
# B01: server-only key signs the invoice EIP-712 payload off-chain; it never pays the invoice.
# The public recipient receives native CAMPUS from the student's on-chain transaction.
# Replace signer only together with a new L04 deployment (signer is immutable).
POS_SIGNER_PRIVATE_KEY=
PARKING_MERCHANT_ADDRESS=
# Library demo persistence uses a private seed JSON containing only synthetic wallets and catalog metadata.
LIBRARY_DB_PATH=
LIBRARY_SEED_FILE=
# Set true only for an explicitly configured local-anvil Library deployment.
LIBRARY_ALLOW_LOCAL_ANVIL=false
LIBRARY_AUTH_ORIGIN=
# Exact IPs of trusted frontend proxy peers; default is local loopback only.
LIBRARY_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
# Required auth limits and TTLs; use HTTP only with localhost plus explicit opt-in.
LIBRARY_CHALLENGE_TTL_SECONDS=
LIBRARY_SESSION_TTL_SECONDS=
LIBRARY_CHALLENGE_RATE_LIMIT_MAX_REQUESTS=
LIBRARY_CHALLENGE_RATE_LIMIT_WINDOW_SECONDS=
LIBRARY_VERIFY_RATE_LIMIT_MAX_REQUESTS=
LIBRARY_VERIFY_RATE_LIMIT_WINDOW_SECONDS=
LIBRARY_ALLOW_INSECURE_LOCALHOST=false

# Persistent SQLite menu/order store for the canteen module.
# CANTEEN_DB_PATH=/absolute/path/canteen.sqlite
