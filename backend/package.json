{
  "name": "@intracampus/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "rpc:check": "node --env-file-if-exists=.env src/rpc-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "test:b02:evidence": "node test/receipt-evidence.ts",
    "test:b01:evidence": "node --test --test-name-pattern=creates test/invoice-create.test.ts",
    "test:b01:local": "node test/invoice-local-evidence.ts",
    "test:b04:local": "node test/b04-local-evidence.ts"
  },
  "dependencies": {
    "@intracampus/network": "workspace:*",
    "ethers": "6.15.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
