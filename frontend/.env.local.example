# Server-side only. Next.js proxies /api/invoices here; set a reachable backend URL in deployed environments.
BACKEND_URL=http://127.0.0.1:4000
# Public values only from L02/L06. No keys or secret RPC tokens. Rebuild after changes.
# HTTPS required except for localhost development.
NEXT_PUBLIC_INTRACAMPUS_RPC_URL=
NEXT_PUBLIC_STUDENT_SBT_ADDRESS=
NEXT_PUBLIC_CAMPUS_PAYMENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_CAMPUS_POS_SIGNER_ADDRESS=
